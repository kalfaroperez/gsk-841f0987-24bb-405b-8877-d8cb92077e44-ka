{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Leaderboard": "Data Source=data/leaderboard.db"
  },
  "Leaderboard": {
    "Window": "7.00:00:00",
    "BucketSize": "00:01:00",
    "FutureSkewTolerance": "00:05:00",
    "MaxPointsPerEvent": 1000000,
    "DefaultTop": 10,
    "MaxTop": 100,
    "CacheTtl": "00:00:01"
  },
  "Auth": {
    "ApiKeys": []
  },
  "RateLimit": {
    "PermitsPerSecond": 500,
    "Burst": 1000
  },
  "Telemetry": {
    "ServiceName": "leaderboard-api",
    "OtlpEndpoint": ""
  }
}
